{
  "name": "electron-tray-timer",
  "version": "1.0.0",
  "description": "Electron timer app with system tray",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "devm": "npm run build && cross-env ALLOW_ONLY_ONE_INSTANCE=false electron .",
    "build": "tsc && tsc --project tsconfig.renderer.json && cp src/index.html src/countdown.html dist/",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json && tsc --project tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write package.json tsconfig.json tsconfig.tests.json tsconfig.renderer.json playwright.config.ts eslint.config.mjs src tests",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.tests.json tsconfig.renderer.json playwright.config.ts eslint.config.mjs src tests",
    "test:unit": "npm run build && node --test tests/unit/*.test.mjs",
    "build:electron": "electron-builder --publish never",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "canvas": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.19.27",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1"
  },
  "build": {
    "appId": "com.electron.tray-timer",
    "productName": "Tray Timer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "portable-mode",
        "to": "portable-mode"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    }
  }
}
